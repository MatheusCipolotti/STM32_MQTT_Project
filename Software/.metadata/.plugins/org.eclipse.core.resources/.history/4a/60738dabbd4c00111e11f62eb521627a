void wizchip_select(void){
    GPIOA->BSRR = (1 << (8 + 16)); // CS LOW
}

void wizchip_deselect(void){
    GPIOA->BSRR = (1 << 8); // CS HIGH
}

uint8_t spi2_readbyte(void){
    return SPI2_Transfer(0xFF);
}

void spi2_writebyte(uint8_t wb){
    SPI2_Transfer(wb);
}
