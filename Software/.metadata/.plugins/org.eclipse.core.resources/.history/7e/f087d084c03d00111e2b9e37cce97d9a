#include "stm32g0b0xx.h"

#include <string.h>

#include "EUSART.h"
#include "main.h"
#include "MCU.h"
#include "SPI.h"

#include "wizchip_conf.h"
#include "wizchip_port.h"

#include "socket.h"

#include "MQTTClient.h"
#include "MQTTPacket.h"
#include "mqtt_interface.h"

//==========Variáveis Globais============
volatile uint32_t miliseconds_counter = 0;

volatile uint8_t usart1_receive_interrupt = 0;
volatile uint8_t usart1_receive_data = 0;
volatile uint8_t usart1_miliseconds_counter = 0;
volatile uint8_t usart1_index = 0;

char menu_buffer[MENU_BUFFER_SIZE];
uint8_t buffer[128];

Network network;
MQTTClient client;

uint8_t sendbuf[256];
uint8_t readbuf[256];

uint8_t mqtt_initialized = 0;
uint8_t mqtt_connected = 0;

//========== TIMER ============
void TIM6_DAC_IRQHandler(void){
    if(TIM6->SR & TIM_SR_UIF){
        TIM6->SR &= ~TIM_SR_UIF;

        miliseconds_counter++;

        if(usart1_miliseconds_counter >= 1){
            usart1_miliseconds_counter--;
        }

        if(miliseconds_counter == 1000){
			LED_ON_BOARD_TOGGLE();
			miliseconds_counter = 0;
		}
    }
}

//========== UART ============
void USART1_IRQHandler(void){
    if(USART1->ISR & USART_ISR_RXNE_RXFNE){
        usart1_receive_data = (uint8_t)USART1->RDR;

        usart1_miliseconds_counter = 20;

        if(usart1_index < MENU_BUFFER_SIZE - 1){
            menu_buffer[usart1_index++] = usart1_receive_data;
            if(usart1_receive_data == '\n'){
            	menu_buffer[usart1_index++] = '\0';
				usart1_index = 0;
				usart1_receive_interrupt = 1;
            }
        }
        else{
            usart1_index = 0;
        }
    }
}

int main(void){
	Osc_Init();
	GPIO_Init();
	TIM6_init();
	UART1_Init(UART1_BAUDRATE);
	SPI2_Init();

	reg_wizchip_cs_cbfunc(wizchip_select, wizchip_deselect);
	reg_wizchip_spi_cbfunc(spi2_readbyte, spi2_writebyte);

	uint8_t txSize[8] = {2,2,2,2,2,2,2,2};
	uint8_t rxSize[8] = {2,2,2,2,2,2,2,2};

	uint8_t broker_ip[4] = {35, 157, 220, 177};

	wizchip_init(txSize, rxSize);

	//	Configura rede
	wiz_NetInfo netinfo = {
	    .mac = {0x00,0x08,0xdc,0x01,0x02,0x03},
	    .ip  = {192,168,0,123},
	    .sn  = {255,255,255,0},
	    .gw  = {192,168,0,1},
	    .dns = {8,8,8,8},
	    .dhcp = NETINFO_STATIC
	};

	wizchip_setnetinfo(&netinfo);

	// Aqui entra o socket
	socket(0, Sn_MR_TCP, 5000, 0);
	listen(0);											//não bloqueante

	while(1){
		switch(getSn_SR(0)){
			case SOCK_ESTABLISHED:
				// Inicializa MQTT (1 vez)
				if (!mqtt_initialized){

					NewNetwork(&network, 0);

					MQTTClientInit(&client, &network, 1000,
								   sendbuf, sizeof(sendbuf),
								   readbuf, sizeof(readbuf));

					mqtt_initialized = 1;

					UART1_Write_Text_ln("TCP conectado");
				}

				// Conecta no broker MQTT (1 vez)
				if (!mqtt_connected){

					MQTTPacket_connectData data = MQTTPacket_connectData_initializer;

					data.MQTTVersion = 4;
					data.clientID.cstring = "stm32_client";

					if (MQTTConnect(&client, &data) == 0){
						mqtt_connected = 1;
						UART1_Write_Text_ln("MQTT conectado");
					}
				}

				// Loop MQTT
				if (mqtt_connected){
					MQTTYield(&client, 100);

					// Envio de teste a cada 1s
					static uint32_t last = 0;

					if (miliseconds_counter != last){
						last = miliseconds_counter;

						MQTTMessage msg;

						char payload[] = "Hello from STM32";

						msg.qos = QOS0;
						msg.retained = 0;
						msg.payload = payload;
						msg.payloadlen = strlen(payload);

						MQTTPublish(&client, "teste/stm32", &msg);
					}
				}
				/*
				// Se tem dados recebidos
				if (getSn_RX_RSR(0) > 0){
					int len = recv(0, buffer, sizeof(buffer) - 1);
					buffer[len] = '\0';
					UART1_Write_Text_ln((char*)buffer);

					if (len > 0){
						// Aqui você recebeu dados
						// Exemplo: eco (responde de volta)
						send(0, buffer, len);
					}
				}

				else if(usart1_receive_interrupt == 1){
					//Desabilita a interrupção de RX
					USART1->CR1 &= ~USART_CR1_RXNEIE_RXFNEIE;

					usart1_receive_interrupt = 0;

					send(0, (uint8_t*)menu_buffer, sizeof(menu_buffer) - 1);
					memset(menu_buffer, '\0', sizeof(menu_buffer));

					//Habilita a interrupção de RX
					USART1->CR1 |= USART_CR1_RXNEIE_RXFNEIE;
				}
				*/
				break;

			case SOCK_CLOSE_WAIT:
				close(0);
				break;

			case SOCK_CLOSED:
				mqtt_initialized = 0;
				mqtt_connected = 0;

				socket(0, Sn_MR_TCP, 0, 0);
				UART1_Write_Text_ln("Desconectado");

				break;

			case SOCK_INIT:
			        connect(0, broker_ip, 1883);
			        break;
		}
	}
}
