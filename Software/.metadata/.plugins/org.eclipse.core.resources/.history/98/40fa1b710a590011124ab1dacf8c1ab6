#include "stm32g0b0xx.h"

#include <string.h>

#include "EUSART.h"
#include "LED_warnings.h"
#include "main.h"
#include "MCU.h"
#include "SPI.h"

#include "wizchip_conf.h"
#include "wizchip_port.h"

#include "socket.h"

//==========Variáveis Globais============
volatile uint32_t millis = 0;

volatile uint8_t usart1_receive_interrupt = 0;
volatile uint8_t usart1_receive_data = 0;
volatile uint8_t usart1_index = 0;

//==========Error Flags============
volatile uint8_t uart1_overflow_flag = 0;
uint8_t W5500_status_flag = 0;

char menu_buffer[MENU_BUFFER_SIZE];
uint8_t buffer[128];

//========== TIMER ============
void TIM6_DAC_IRQHandler(void){
    if(TIM6->SR & TIM_SR_UIF){
        TIM6->SR &= ~TIM_SR_UIF;

        millis++;
    }
}

uint32_t millis_get(void)
{
    return millis;
}

//========== UART ============
void USART1_IRQHandler(void){
	//Dado recebido
    if(USART1->ISR & USART_ISR_RXNE_RXFNE){
        usart1_receive_data = (uint8_t)USART1->RDR;

        if(usart1_index < MENU_BUFFER_SIZE - 2){
            menu_buffer[usart1_index++] = usart1_receive_data;
        }
        else{
            usart1_index = 0;
            uart1_overflow_flag = 1;
        }
    }

    //Character match
	if(USART1->ISR & USART_ISR_CMF){
		USART1->ICR |= USART_ICR_CMCF;

		menu_buffer[usart1_index++] = '\0';
		usart1_index = 0;
		usart1_receive_interrupt = 1;
	}
}

int main(void){
	Osc_Init();
	GPIO_Init();
	TIM6_init();
	UART1_Init(UART1_BAUDRATE);
	SPI2_Init();
	led_warnings_init();

	W5500_status_flag = W5500_Init();

	while(1){
		static uint32_t keep_alive_led_timer = 0;
		uint32_t actual_timer = millis_get();

		if((actual_timer - keep_alive_led_timer) >= 2000){
			keep_alive_led_timer = actual_timer;
			led_warning_test();
		}

		switch(getSn_SR(0)){
			case SOCK_ESTABLISHED:
				// Se tem dados recebidos
				if (getSn_RX_RSR(0) > 0){
					int len = recv(0, buffer, sizeof(buffer) - 1);
					buffer[len] = '\0';

					if (len > 0){
						UART1_Write_Text_ln((char*)buffer);
						send(0, buffer, len);									//eco
					}
				}

				//Envia os comandos da UART
				else if(usart1_receive_interrupt == 1){
					//Desabilita a interrupção de RX
					USART1->CR1 &= ~USART_CR1_RXNEIE_RXFNEIE;

					usart1_receive_interrupt = 0;

					send(0, (uint8_t*)menu_buffer, sizeof(menu_buffer) - 1);
					memset(menu_buffer, '\0', sizeof(menu_buffer));

					//Habilita a interrupção de RX
					USART1->CR1 |= USART_CR1_RXNEIE_RXFNEIE;
				}
				break;

			case SOCK_CLOSE_WAIT:
				close(0);
				break;

			case SOCK_CLOSED:
				socket(0, Sn_MR_TCP, 5000, 0);
				listen(0);
				UART1_Write_Text_ln("Desconectado");
				break;
		}
	}
}
